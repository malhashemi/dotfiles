{
  "proxy": {
    "host": "127.0.0.1",
    "port": 8317,
    "remote-management": {
      "allow-remote": false,
      "secret-key": "",
      "disable-control-panel": true
    },
    "debug": false,
    "logging-to-file": false,
    "request-log": false,
    "request-retry": 2,
    "max-retry-interval": 15,
    "routing": {
      "strategy": "fill-first",
      "session-affinity": true,
      "session-affinity-ttl": "720h",
      "session-affinity-subagents": true
    },
    "streaming": {
      "keepalive-seconds": 15,
      "bootstrap-retries": 1
    },
    "force-model-prefix": false,
    "save-cooldown-status": true
  },
  "t3_version": "0.1.5"
}
