# agent-desktop: managed by chezmoi (machine.autologin); the opt-out removes it.
[Unit]
Description=wayvnc remote view of the Hyprland session (Tailscale only)
Documentation=man:wayvnc(1)
# Agent desktops only (machine.autologin). Keyed off the uwsm-activated
# graphical-session.target so it inherits WAYLAND_DISPLAY; the wrapper binds
# only to the tailscale0 address and reads ~/.config/wayvnc/config.
After=graphical-session.target
PartOf=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/wayvnc-tailscale
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
