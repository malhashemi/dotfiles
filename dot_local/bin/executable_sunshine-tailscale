#!/usr/bin/env bash
# agent-desktop: managed by chezmoi (machine.autologin); the opt-out removes it.
# Stream the Hyprland session with Sunshine (for Moonlight) over Tailscale only.
#
# Started by sunshine.service inside the graphical session. Sunshine can bind
# one address but not a device, so two layers keep it off every interface but
# tailscale0:
#   - agent-desktop-vnc-guard.service: nftables (inet, so IPv4 and IPv6) drops
#     Sunshine's ports (tcp and udp 47984-48010) off tailscale0 and lo. This is
#     the boundary: Linux accepts packets for a local address on any interface.
#   - every Sunshine socket is bound to the tailscale0 IPv4 address (IPv4 only),
#     so nothing listens on the LAN, docker or IPv6 addresses.
# The security settings are passed on the command line, which overrides
# ~/.config/sunshine/sunshine.conf, so a setting saved in the web UI cannot
# widen them: the base port stays inside the guarded range, the web UI admits
# only localhost and private ranges (with the guard: Tailscale), UPnP stays off,
# and the credential and state store is pinned to the one file checked below.
# It refuses to start unless the guard unit is active, tailscale0 has an IPv4
# address, that store holds the login from web-ui-credentials (without one,
# Sunshine lets the first visitor of the web UI set it; see
# sunshine-credentials) and Avahi is off: Sunshine has no setting to stop
# publishing itself over mDNS, and Avahi would announce it on every interface.
# It keeps watching: if the address changes or the guard goes away, it stops
# Sunshine and exits non-zero so systemd restarts it (on the new address, or
# not at all without the guard).
# Capture: KMS (the package grants /usr/bin/sunshine cap_sys_admin); encoding:
# VAAPI on the first render node.
#
# Agent desktops only (machine.autologin).
set -euo pipefail

guard=agent-desktop-vnc-guard.service
# Sunshine's credential and pairing store; pinned below for both settings.
store="${XDG_CONFIG_HOME:-$HOME/.config}/sunshine/sunshine_state.json"

die() {
    echo "sunshine-tailscale: $*" >&2
    exit 1
}

tailscale_addr() {
    ip -4 -o addr show dev tailscale0 2>/dev/null | awk '{ split($4, a, "/"); print a[1]; exit }'
}

systemctl is-active --quiet "$guard" || die "$guard is not active; refusing to stream without the firewall guard."
"$HOME/.local/bin/sunshine-credentials" check ||
    die "$store does not hold the web UI login from web-ui-credentials; run sunshine-credentials sync (or chezmoi apply)."
for avahi in avahi-daemon.service avahi-daemon.socket; do
    if systemctl is-active --quiet "$avahi" || systemctl is-enabled --quiet "$avahi" 2>/dev/null; then
        die "$avahi is enabled or running; Sunshine would announce itself over mDNS on every interface. Disable Avahi or remove this check deliberately."
    fi
done

# tailscaled may still be connecting at boot; the unit restarts us until it is.
addr=$(tailscale_addr)
[[ -n "$addr" ]] || die "tailscale0 has no IPv4 address yet."

/usr/bin/sunshine \
    "bind_address=$addr" \
    "file_state=$store" \
    "credentials_file=$store" \
    address_family=ipv4 \
    port=47989 \
    origin_web_ui_allowed=lan \
    upnp=disabled \
    capture=kms \
    encoder=vaapi \
    adapter_name=/dev/dri/renderD128 &
server=$!
trap 'kill "$server" 2>/dev/null || true' EXIT

while kill -0 "$server" 2>/dev/null; do
    sleep 15 &
    wait $! || true
    kill -0 "$server" 2>/dev/null || break
    if [[ "$(tailscale_addr)" != "$addr" ]]; then
        die "tailscale0 address changed from $addr; restarting on the new one."
    fi
    if ! systemctl is-active --quiet "$guard"; then
        die "$guard stopped; shutting Sunshine down."
    fi
done
trap - EXIT
wait "$server"
