#!/usr/bin/env bash
# Install the original WebDevCaptain scheduler from its verified release ZIP.
set -euo pipefail
umask 077
plugin=quota-reset-router
version=0.2.1
directory="${HOME}/.config/cli-proxy-api/plugins"
case "$(uname -sm)" in
  'Linux x86_64') platform=linux_amd64; ext=so; digest=228ed40ee438bbd45cf5744dc30d070f4d65f6d0e69a18a3448b43b2d9c35743 ;;
  'Linux aarch64') platform=linux_arm64; ext=so; digest=57ec2d9ff3ca0b6708b9ef406d44eb833ec2fdcf1616a2907410fc4698bde472 ;;
  'Darwin x86_64') platform=darwin_amd64; ext=dylib; digest=cb5874d1041bb654fc8e25ed184c8f62e332e95e6a9daad6912946673baf2933 ;;
  'Darwin arm64') platform=darwin_arm64; ext=dylib; digest=429ca107f2d95d009e443922b230cfb9f8a3ce34f626b8f1a0bc5551b1f1128d ;;
  *) echo "Unsupported quota router platform: $(uname -sm)" >&2; exit 1 ;;
esac
mkdir -p "$directory"
library="$plugin.$ext"
receipt="$directory/.$plugin-$platform.receipt"
hash_file() { shasum -a 256 "$1" | cut -d ' ' -f 1; }
if [[ -f "$directory/$library" && -f "$receipt" ]] &&
   [[ "$(cat "$receipt")" == "$digest $(hash_file "$directory/$library")" ]]; then
  exit 0
fi
work=$(mktemp -d "$directory/.install-quota-router.XXXXXXXX")
trap 'rm -rf "$work"' EXIT
url="https://github.com/WebDevCaptain/$plugin/releases/download/v$version/${plugin}_${version}_${platform}.zip"
xh --ignore-stdin --follow --check-status --download --quiet --output "$work/artifact" GET "$url"
[[ "$(hash_file "$work/artifact")" == "$digest" ]] || { echo 'Quota router checksum mismatch' >&2; exit 1; }
unzip -p "$work/artifact" "$library" > "$work/$library"
test -s "$work/$library"
chmod 700 "$work/$library"
printf '%s %s\n' "$digest" "$(hash_file "$work/$library")" > "$work/receipt"
mv -f "$work/$library" "$directory/$library"
mv -f "$work/receipt" "$receipt"
