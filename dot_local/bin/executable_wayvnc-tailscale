#!/usr/bin/env bash
# Serve the Hyprland session over VNC on this machine's Tailscale address only.
#
# Started by wayvnc.service inside the graphical session. Binding to the
# tailscale0 IPv4 address keeps the server off the LAN; the nftables guard in
# run_onchange_after_enable-rescue-services.sh.tmpl also drops tcp/5900 on every
# other interface. Credentials live in ~/.config/wayvnc/config (0600, generated
# on the machine, never in the dotfiles repo). Connect from macOS Screen Sharing:
#     vnc://<tailscale-hostname>:5900
#
# Agent desktops only (machine.autologin).
set -euo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}/wayvnc/config"
[[ -r "$config" ]] || {
    echo "wayvnc-tailscale: $config is missing; run chezmoi apply." >&2
    exit 1
}
# Never serve the desktop without a password.
grep -qx 'enable_auth=true' "$config" || {
    echo "wayvnc-tailscale: $config does not set enable_auth=true; refusing to start." >&2
    exit 1
}

# tailscaled may still be connecting at boot; the unit restarts us until it is.
addr=$(ip -4 -o addr show dev tailscale0 2>/dev/null | awk '{ split($4, a, "/"); print a[1]; exit }')
[[ -n "$addr" ]] || {
    echo "wayvnc-tailscale: tailscale0 has no IPv4 address yet." >&2
    exit 1
}

# A patched libneatvnc (see run_onchange_after_agent-desktop.sh.tmpl, step 5b)
# fixes the Apple DH crash; use it only while it matches the system package.
neatvnc_lib="$HOME/.local/lib/wayvnc"
if [[ "$(cat "$neatvnc_lib/built-for" 2>/dev/null)" == "$(pacman -Q neatvnc 2>/dev/null)" ]]; then
    export LD_LIBRARY_PATH="$neatvnc_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

# --render-cursor draws the pointer into the frames, so the viewer sees where
# agents (and their uinput pointer) are pointing.
exec wayvnc --config="$config" --render-cursor "$addr" 5900
