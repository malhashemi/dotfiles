#!/usr/bin/env bash
# Serve the Hyprland session over VNC on this machine's Tailscale address only.
#
# Started by wayvnc.service inside the graphical session. Two independent
# layers keep VNC off every interface but tailscale0:
#   - the listening socket itself: created here bound to the tailscale0 address
#     AND to the tailscale0 device (SO_BINDTODEVICE), then handed to wayvnc as
#     an inherited fd. The kernel delivers connections to it only from
#     tailscale0, whatever the firewall state. (Binding to the address alone
#     does not: Linux accepts packets for a local address on any interface.)
#   - agent-desktop-vnc-guard.service: nftables drops tcp/5900 off tailscale0.
# It refuses to serve unless ~/.config/wayvnc/config passes the strict check
# below and the guard unit is active. It keeps watching: if the tailscale0
# address changes or the guard goes away, it stops wayvnc and exits non-zero
# so systemd restarts it (on the new address, or not at all without the guard).
# Credentials are generated on the machine, never kept in the dotfiles repo.
# Connect from macOS Screen Sharing: vnc://<tailscale-hostname>:5900
#
#     wayvnc-tailscale                 run the server (wayvnc.service does this)
#     wayvnc-tailscale --check-config  validate the config only (exit 0 = ok)
#
# Agent desktops only (machine.autologin).
set -euo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}/wayvnc/config"
guard=agent-desktop-vnc-guard.service
port=5900

die() {
    echo "wayvnc-tailscale: $*" >&2
    exit 1
}

# Strict reading of wayvnc's key=value format. The file must be UTF-8 with no
# NUL or other control bytes (wayvnc's C loader would cut a value at a NUL),
# every non-empty line exactly `key=value` with a known key and no whitespace,
# each key at most once (wayvnc lets a later duplicate win), auth on, a
# non-empty username and password, and no PAM or legacy DES auth. Comments and
# padded lines are rejected too: only the agent-desktop setup writes this file,
# and it writes none. Prints the first problem; never prints values.
check_config() {
    python3 -I - "$1" <<'PY'
import re
import sys

KNOWN = {
    'address', 'port', 'enable_auth', 'relax_encryption', 'allow_broken_crypto',
    'enable_pam', 'username', 'password', 'private_key_file', 'certificate_file',
    'rsa_private_key_file', 'use_relative_paths', 'xkb_layout', 'xkb_variant',
    'xkb_model', 'xkb_options', 'xkb_rules',
}


def fail(message):
    print(message)
    sys.exit(1)


path = sys.argv[1]
try:
    with open(path, 'rb') as handle:
        data = handle.read()
except OSError:
    fail(f'{path} is missing or unreadable')
try:
    text = data.decode('utf-8')
except UnicodeDecodeError:
    fail('the file is not valid UTF-8')
if any(ch != '\n' and (ord(ch) < 0x20 or 0x7f <= ord(ch) <= 0x9f) for ch in text):
    fail('the file contains NUL or other control characters')
values = {}
for number, line in enumerate(text.split('\n'), 1):
    if line == '':
        continue
    if not re.fullmatch(r'[a-z_]+=\S*', line):
        fail(f'line {number} is not plain key=value')
    key, value = line.split('=', 1)
    if key not in KNOWN:
        fail(f'unknown key {key}')
    if key in values:
        fail(f'duplicate key {key}')
    values[key] = value
if values.get('enable_auth') != 'true':
    fail('enable_auth=true is required')
if not values.get('username'):
    fail('a non-empty username is required')
if not values.get('password'):
    fail('a non-empty password is required')
if values.get('enable_pam', 'false') != 'false':
    fail('enable_pam is not allowed')
if values.get('allow_broken_crypto', 'false') != 'false':
    fail('allow_broken_crypto is not allowed')
PY
}

tailscale_addr() {
    ip -4 -o addr show dev tailscale0 2>/dev/null | awk '{ split($4, a, "/"); print a[1]; exit }'
}

if [[ "${1:-}" == "--check-config" ]]; then
    problem=$(check_config "${2:-$config}") || {
        echo "wayvnc-tailscale: ${2:-$config}: $problem" >&2
        exit 1
    }
    exit 0
fi

problem=$(check_config "$config") || die "$config: $problem; refusing to start."
systemctl is-active --quiet "$guard" || die "$guard is not active; refusing to serve VNC without the firewall guard."

# tailscaled may still be connecting at boot; the unit restarts us until it is.
addr=$(tailscale_addr)
[[ -n "$addr" ]] || die "tailscale0 has no IPv4 address yet."

# A patched libneatvnc (see run_onchange_after_agent-desktop.sh.tmpl) fixes the
# Apple DH crash; use it only while it matches the system package.
neatvnc_lib="$HOME/.local/lib/wayvnc"
if [[ "$(cat "$neatvnc_lib/built-for" 2>/dev/null)" == "$(pacman -Q neatvnc 2>/dev/null)" ]]; then
    export LD_LIBRARY_PATH="$neatvnc_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

# Create the device-bound listener, then exec wayvnc on it (`fd:N`), keeping
# the PID. --render-cursor draws the pointer into the frames, so the viewer
# sees where agents (and their uinput pointer) are pointing.
python3 -I -c '
import os, socket, sys
addr, port = sys.argv[1], int(sys.argv[2])
listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
listener.setsockopt(socket.SOL_SOCKET, socket.SO_BINDTODEVICE, b"tailscale0")
listener.bind((addr, port))
listener.listen(16)
os.set_inheritable(listener.fileno(), True)
os.execvp("wayvnc", ["wayvnc", *sys.argv[3:], "fd:%d" % listener.fileno()])
' "$addr" "$port" --config="$config" --render-cursor &
server=$!
trap 'kill "$server" 2>/dev/null || true' EXIT

while kill -0 "$server" 2>/dev/null; do
    sleep 15 &
    wait $! || true
    kill -0 "$server" 2>/dev/null || break
    if [[ "$(tailscale_addr)" != "$addr" ]]; then
        die "tailscale0 address changed from $addr; restarting on the new one."
    fi
    if ! systemctl is-active --quiet "$guard"; then
        die "$guard stopped; shutting VNC down."
    fi
done
trap - EXIT
wait "$server"
