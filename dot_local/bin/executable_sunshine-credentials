#!/usr/bin/env bash
# agent-desktop: managed by chezmoi (machine.autologin); the opt-out removes it.
# Keep Sunshine's web UI credentials in step with the generated login file.
#
#     sunshine-credentials check  exit 0 only if Sunshine's store holds the
#                                 login from web-ui-credentials
#     sunshine-credentials sync   repair the store if it does not; Sunshine is
#                                 stopped while the store is written and
#                                 started again if it was running
#
# web-ui-credentials (0600, generated by the agent-desktop setup) is the source
# of truth. The store is ~/.config/sunshine/sunshine_state.json, the exact path
# sunshine-tailscale pins for both `credentials_file` and `file_state`. Sunshine
# keeps its pairings in the same file, so sync rewrites only the username,
# salt and password keys, atomically and 0600, and never replaces a store it
# cannot parse. The password never appears in process arguments: the salted
# hash is computed here the way Sunshine does it (sha256 of password + salt,
# upper-case hex of the digest bytes last to first).
#
# Agent desktops only (machine.autologin).
set -euo pipefail

dir="${XDG_CONFIG_HOME:-$HOME/.config}/sunshine"
creds="$dir/web-ui-credentials"
store="$dir/sunshine_state.json"
unit=sunshine.service

die() {
    echo "sunshine-credentials: $*" >&2
    exit 1
}

# login_store MODE: check (exit 0 match, 1 mismatch) or write (replace the login
# keys); exit 2 when a file is unreadable or unparsable.
login_store() {
    python3 -I - "$1" "$creds" "$store" <<'PY'
import hashlib
import json
import os
import secrets
import sys
import tempfile

mode, creds_path, store_path = sys.argv[1:]
# Sunshine's salt alphabet (crypto::rand_alphabet).
ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!%&()=-'


def problem(message):
    print(f'sunshine-credentials: {message}', file=sys.stderr)
    sys.exit(2)


def sunshine_hash(password, salt):
    return hashlib.sha256((password + salt).encode()).digest()[::-1].hex().upper()


try:
    login = {}
    with open(creds_path, encoding='utf-8') as handle:
        for line in handle.read().splitlines():
            if not line.startswith('#') and '=' in line:
                key, value = line.split('=', 1)
                login[key] = value
except OSError as error:
    problem(f'cannot read {creds_path}: {error}')
if not login.get('username') or not login.get('password'):
    problem(f'{creds_path} has no username or password')
try:
    with open(store_path, encoding='utf-8') as handle:
        state = json.load(handle)
except FileNotFoundError:
    state = {}
except (OSError, ValueError) as error:
    problem(f'cannot parse {store_path} (left untouched): {error}')
if not isinstance(state, dict):
    problem(f'{store_path} is not a JSON object (left untouched)')

salt = state.get('salt')
matches = (isinstance(salt, str) and salt != ''
           and str(state.get('username', '')).lower() == login['username'].lower()
           and state.get('password') == sunshine_hash(login['password'], salt))
if mode == 'check':
    sys.exit(0 if matches else 1)

salt = ''.join(secrets.choice(ALPHABET) for _ in range(16))
state.update(username=login['username'], salt=salt,
             password=sunshine_hash(login['password'], salt))
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(store_path), prefix='.sunshine_state.')
try:
    with os.fdopen(fd, 'w', encoding='utf-8') as handle:  # mkstemp: 0600
        json.dump(state, handle, indent=4, ensure_ascii=False)
        handle.write('\n')
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(tmp, store_path)
except BaseException:
    os.unlink(tmp)
    raise
PY
}

case "${1:-}" in
    check)
        login_store check
        ;;
    sync)
        rc=0
        login_store check || rc=$?
        case $rc in
            0)
                chmod 0600 "$store"
                exit 0
                ;;
            1) ;;
            *) exit 1 ;;
        esac
        # Sunshine rewrites the store when it pairs: write it only while
        # Sunshine is not running.
        was_active=false
        if systemctl --user is-active --quiet "$unit"; then
            was_active=true
            systemctl --user stop "$unit"
        fi
        if pgrep -u "$(id -u)" -x sunshine >/dev/null; then
            [[ "$was_active" == false ]] || systemctl --user start "$unit"
            die "a Sunshine outside $unit is running; stop it, then retry."
        fi
        login_store write || {
            [[ "$was_active" == false ]] || systemctl --user start "$unit"
            die "could not write $store"
        }
        login_store check || die "$store still does not match after the repair"
        echo "sunshine-credentials: restored the web UI login in $store from $creds"
        if [[ "$was_active" == true ]]; then
            systemctl --user start "$unit"
        fi
        ;;
    *)
        echo "usage: sunshine-credentials check|sync" >&2
        exit 2
        ;;
esac
