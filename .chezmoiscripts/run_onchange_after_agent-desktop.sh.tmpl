{{- /*
  Agent desktop (machine.autologin) setup, and its undo.
  - autologin on (Linux): the setup below. Its first action records the
    opt-in in ~/.local/state/agent-desktop/enabled-at.
  - autologin off on a Linux machine with that marker, or with any piece this
    setup provably wrote (also covers interrupted and pre-marker installs):
    the opt-out transition. Proof of ownership: the `agent-desktop: managed by
    chezmoi` line every written file carries, the pinned hashes for the
    computer-use-linux binaries, or (MCP) our launcher as the command.
    Look-alike files alone render nothing.
  - every other machine: renders empty, so nothing runs.
  Each branch embeds the other's state, so a later opt-in or opt-out renders
  new content and runs again.
*/ -}}
{{- $linux := eq .chezmoi.os "linux" -}}
{{- $enable := and $linux (get (get . "machine" | default dict) "autologin") -}}
{{- $home := .chezmoi.homeDir -}}
{{- $stateDir := joinPath $home ".local/state/agent-desktop" -}}
{{- $enabledAt := joinPath $stateDir "enabled-at" -}}
{{- $disabledAt := joinPath $stateDir "disabled-at" -}}
{{- $launcher := joinPath $home ".local/bin/computer-use-linux-session" -}}
{{- $token := "agent-desktop: managed by chezmoi" -}}
{{- /* computer-use-linux release binaries (v0.7.36); bump all three together. */ -}}
{{- $binHashes := dict
      "computer-use-linux" "d18c837cea6fa038475a2fbc94e6f238ad6722143375e263d1835533fd42b0ff"
      "computer-use-linux-cosmic" "a75106aa2c67f1acbc68086965f73852e44abf5c38117ed058d6e5e14c3e5a0b"
      "computer-use-linux-indicator" "4014b4dc18c5c9356f6ecf982459f895b1679a82ac4ed5655e1195e1231860e0" -}}
{{- $owned := list -}}
{{- $lookalikes := list -}}
{{- $hints := list -}}
{{- if and $linux (not $enable) -}}
{{- /* wayvnc pieces are retired (Sunshine replaced them) but still count, for
       machines that opted in while they existed. */ -}}
{{-   range $path := list
        (joinPath $home ".config/systemd/user/wayvnc.service")
        (joinPath $home ".config/systemd/user/agent-chrome.service")
        (joinPath $home ".config/systemd/user/xdg-desktop-portal.service.d/agent-desktop.conf")
        $launcher
        (joinPath $home ".local/bin/wayvnc-tailscale")
        (joinPath $home ".local/lib/wayvnc/agent-desktop-managed")
        (joinPath $home ".config/systemd/user/sunshine.service")
        (joinPath $home ".local/bin/sunshine-tailscale")
        (joinPath $home ".local/bin/sunshine-pair")
        (joinPath $home ".local/bin/sunshine-credentials")
        "/etc/pacman.d/hooks/agent-desktop-sunshine-cap.hook"
        "/etc/systemd/system/agent-desktop-vnc-guard.service"
        "/etc/systemd/system/nftables.service.d/agent-desktop-vnc-guard.conf"
        "/etc/agent-desktop/vnc-guard.nft"
        "/etc/agent-desktop/nftables-with-vnc-guard.nft"
        "/etc/udev/rules.d/60-agent-desktop-uinput.rules"
        "/etc/modules-load.d/agent-desktop-uinput.conf" -}}
{{-     $info := stat $path -}}
{{-     if $info -}}
{{-       if and (not $info.isDir) (contains $token (include $path)) }}{{ $owned = append $owned $path }}{{ else }}{{ $lookalikes = append $lookalikes $path }}{{ end -}}
{{-     end -}}
{{-   end -}}
{{-   range $name, $hash := $binHashes -}}
{{-     $path := joinPath $home ".local/bin" $name -}}
{{-     $info := stat $path -}}
{{-     if $info -}}
{{-       if and (not $info.isDir) (eq (include $path | sha256sum) $hash) }}{{ $owned = append $owned $path }}{{ else }}{{ $lookalikes = append $lookalikes $path }}{{ end -}}
{{-     end -}}
{{-   end -}}
{{-   range $config := list (joinPath $home ".codex/config.toml") (joinPath $home ".claude.json") (joinPath $home ".claude-t3-mixed/.claude.json") -}}
{{-     if and (stat $config) (contains "computer-use-linux-session" (include $config)) }}{{ $hints = append $hints $config }}{{ end -}}
{{-   end -}}
{{- end -}}
{{- /* MCP configs are only a hint here (templates cannot parse them safely);
       the script's runtime gate parses them and changes nothing unless
       something is proven ours. */ -}}
{{- $disable := and $linux (not $enable) (or (stat $enabledAt) (gt (len $owned) 0) (gt (len $hints) 0)) -}}
{{ if or $enable $disable -}}
#!/usr/bin/env bash
{{- if $enable }}
# Agent desktop (machine.autologin): make this Hyprland desktop drivable by AI
# agents that reach it over SSH (T3, Codex, Claude Code). Delivers:
#   - computer use: computer-use-linux (pinned release binaries, sha256-checked)
#       in ~/.local/bin, run through ~/.local/bin/computer-use-linux-session,
#       which borrows the live Hyprland session environment. Registered as the
#       `computer-use-linux` MCP server for Codex and for Claude Code in both
#       config homes (~/.claude and ~/.claude-t3-mixed, the one T3 uses).
#   - input: /dev/uinput (absolute pointer) via a uaccess udev rule, so the
#       logged-in seat user gets it without group changes or a re-login; text
#       and keys go through wtype on Hyprland.
#   - accessibility: AT-SPI on (toolkit-accessibility), for element trees.
#   - agent Chrome: agent-chrome.service, its own profile in
#       ~/.local/share/agent-chrome, DevTools on 127.0.0.1:9222 for agent-browser
#       (pinned, in the user's ~/.npm-global).
#   - remote view: Sunshine (pinned upstream Arch package, sha256-checked) as
#       sunshine.service for Moonlight: KMS capture, VAAPI encoding, bound to
#       the tailscale0 IPv4 address behind agent-desktop-vnc-guard.service
#       (nftables, installed first and independent of Tailscale being up), web
#       UI with generated credentials (~/.config/sunshine/web-ui-credentials,
#       0600), pairing through `sunshine-pair PIN`. It replaced wayvnc; what
#       an earlier version of this setup wrote for wayvnc is removed here.
#   - no idle lock: hypridle.conf renders without lock/dpms/suspend listeners
#       here; the running hypridle is restarted to pick it up.
#
# Idempotent; re-runs whenever this script or a hashed file below changes, and
# after a failed run. It never restarts the Hyprland session, T3 or agents.
#   hypridle.conf:         {{ include "dot_config/hypr/hypridle.conf.tmpl" | sha256sum }}
#   agent-chrome.service:  {{ include "dot_config/systemd/user/agent-chrome.service" | sha256sum }}
#   portal drop-in:        {{ include "dot_config/systemd/user/xdg-desktop-portal.service.d/agent-desktop.conf" | sha256sum }}
#   session launcher:      {{ include "dot_local/bin/executable_computer-use-linux-session" | sha256sum }}
#   sunshine.service:      {{ include "dot_config/systemd/user/sunshine.service" | sha256sum }}
#   sunshine wrapper:      {{ include "dot_local/bin/executable_sunshine-tailscale" | sha256sum }}
#   sunshine-pair:         {{ include "dot_local/bin/executable_sunshine-pair" | sha256sum }}
#   sunshine-credentials:  {{ include "dot_local/bin/executable_sunshine-credentials" | sha256sum }}
#   last opt-out:          {{ if stat $disabledAt }}{{ include $disabledAt | trim }}{{ else }}never{{ end }}
{{- else }}
# Agent desktop opt-out: machine.autologin is off on a machine the agent-desktop
# setup ran on (opted in at {{ if stat $enabledAt }}{{ include $enabledAt | trim }}{{ else }}an unrecorded time{{ end }}). Undo the
# agent access it added: MCP registrations, agent Chrome and Sunshine services
# (and wayvnc's, from older versions), the firewall guard (only once nothing
# listens on 5900 or Sunshine's ports), the uinput rule, the Sunshine
# capability hook, the session helpers, and hypridle's no-lock policy (chezmoi
# has already restored hypridle.conf).
# Any failure exits non-zero and keeps the marker, so the next apply retries.
# Kept, because they are data: the Chrome profile (~/.local/share/agent-chrome),
# the wayvnc credentials and ~/.config/sunshine (pairings, web UI
# credentials); installed packages stay too.
# Written by this setup (removed):
{{- range $owned }}
#   - {{ . }}
{{- end }}
# Look-alikes without the ownership proof (left alone):
{{- range $lookalikes }}
#   - {{ . }}
{{- end }}
# MCP configs mentioning our launcher (parsed at runtime; only an entry whose
# command is exactly our launcher counts as ours):
{{- range $hints }}
#   - {{ . }}
{{- end }}
{{- end }}
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$PATH"
uid=$(id -u)
runtime="/run/user/$uid"
# Tailscale SSH sessions skip pam_systemd; point user-bus tools at the session.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$runtime}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

state_dir={{ $stateDir | quote }}
user_units="$HOME/.config/systemd/user"
wants="$user_units/graphical-session.target.wants"
launcher="$HOME/.local/bin/computer-use-linux-session"
vnc_config="$HOME/.config/wayvnc/config"
neatvnc_lib="$HOME/.local/lib/wayvnc"
vnc_restart_marker="$state_dir/wayvnc-restart-required"
sunshine_dir="$HOME/.config/sunshine"
sunshine_creds="$sunshine_dir/web-ui-credentials"
sunshine_restart_marker="$state_dir/sunshine-restart-required"
sunshine_hook=/etc/pacman.d/hooks/agent-desktop-sunshine-cap.hook
# Sunshine's ports for base port 47989 (47984-48010, tcp and udp); the wrapper
# pins the base port so a web UI setting cannot move them out of the guard.
sunshine_ports=47984-48010
# Every file this setup writes carries this line; the opt-out removes only
# files that do (plus binaries matching the pinned hashes), never look-alikes.
owner_token='agent-desktop: managed by chezmoi'
owner_header="# $owner_token (machine.autologin); the opt-out removes it."
declare -A bin_sha256=(
{{- range $name, $hash := $binHashes }}
    [{{ $name }}]={{ $hash }}
{{- end }}
)
guard_unit=/etc/systemd/system/agent-desktop-vnc-guard.service
guard_rules=/etc/agent-desktop/vnc-guard.nft
guard_bundle=/etc/agent-desktop/nftables-with-vnc-guard.nft
guard_dropin=/etc/systemd/system/nftables.service.d/agent-desktop-vnc-guard.conf
uinput_rule=/etc/udev/rules.d/60-agent-desktop-uinput.rules
uinput_module=/etc/modules-load.d/agent-desktop-uinput.conf

# user_manager: 0 when the user systemd manager answers, 1 only when it is
# positively absent (no `systemd --user` process for us and no private
# socket). A manager that seems to exist but does not answer, or a failing
# pgrep, aborts the script (non-zero), so no step is skipped by mistake.
user_manager() {
    local rc=0
    if systemctl --user show-environment >/dev/null 2>&1; then
        return 0
    fi
    pgrep -u "$uid" -x systemd >/dev/null || rc=$?
    if ((rc == 1)) && [[ ! -S "$XDG_RUNTIME_DIR/systemd/private" ]]; then
        return 1
    fi
    echo "agent-desktop: cannot tell whether the user systemd manager runs (it seems to exist but does not answer, or pgrep failed); retry with chezmoi apply" >&2
    exit 1
}

claude_in() {
    # Run claude against one config home; "" is the default (~/.claude), even
    # when this apply runs from inside a T3 session that exported another.
    local config_dir=$1
    shift
    if [[ -n "$config_dir" ]]; then
        CLAUDE_CONFIG_DIR="$config_dir" claude "$@"
    else
        env -u CLAUDE_CONFIG_DIR claude "$@"
    fi
}
claude_homes=("")
if [[ -d "$HOME/.claude-t3-mixed" ]]; then
    claude_homes+=("$HOME/.claude-t3-mixed")
fi

restart_hypridle() {
    # hypridle reads its config only at start: restart just that process,
    # inside the running Hyprland, so the current policy applies now.
    local hypr_pid signature="" lock
    hypr_pid=$(pgrep -n -u "$uid" -x Hyprland || true)
    [[ -n "$hypr_pid" ]] || return 0
    for lock in "$runtime"/hypr/*/hyprland.lock; do
        if [[ -f "$lock" && "$(head -n1 "$lock")" == "$hypr_pid" ]]; then
            signature=$(basename "$(dirname "$lock")")
        fi
    done
    [[ -n "$signature" ]] || return 0
    pkill -u "$uid" -x hypridle || true
    XDG_RUNTIME_DIR="$runtime" HYPRLAND_INSTANCE_SIGNATURE="$signature" \
        hyprctl dispatch 'hl.dsp.exec_cmd("hypridle")' >/dev/null
    echo "  ✓ hypridle restarted"
}
fail() {
    echo "agent-desktop: $*; stopping here (nothing more changed), retry with chezmoi apply" >&2
    exit 1
}

# classify PATH -> owned | foreign | absent. Owned means it carries the
# ownership line, or (binaries) matches a pinned hash. Exits non-zero when it
# cannot tell, which aborts the opt-out.
classify() {
    local path=$1 name sum rc=0
    if [[ ! -e "$path" && ! -L "$path" ]]; then
        echo absent
        return 0
    fi
    name=$(basename "$path")
    if [[ -n "${bin_sha256[$name]:-}" ]]; then
        sum=$(sha256sum -- "$path") || return 1
        if [[ "${sum%% *}" == "${bin_sha256[$name]}" ]]; then echo owned; else echo foreign; fi
        return 0
    fi
    grep -qF -- "$owner_token" "$path" || rc=$?
    case $rc in
        0) echo owned ;;
        1) echo foreign ;;
        *) return 1 ;;
    esac
}

# remove_owned [--sudo] PATH...: delete only owned files; report look-alikes.
remove_owned() {
    local run=() path state
    if [[ "$1" == --sudo ]]; then
        run=(sudo)
        shift
    fi
    for path in "$@"; do
        state=$(classify "$path") || fail "cannot inspect $path"
        case $state in
            owned)
                "${run[@]}" rm -f -- "$path" || fail "cannot remove $path"
                echo "  ✓ removed $path"
                ;;
            foreign) echo "  ⚠ left $path alone: not written by this setup" ;;
        esac
    done
}
{{- if $enable }}

echo "==> agent desktop: computer use, agent Chrome, Sunshine, no idle lock"

# Prime sudo once for the whole setup.
sudo -v

# 0. Record the opt-in before changing anything, so turning machine.autologin
#    off later runs the undo even if this run stops halfway.
mkdir -p "$state_dir"
[[ -s "$state_dir/enabled-at" ]] || date -Is >"$state_dir/enabled-at"

# 1. Firewall guard, first and unconditionally: drop Sunshine's tcp and udp
#    ports on every interface except tailscale0 and lo, for IPv4 and IPv6 (an
#    inet table). It is Sunshine's boundary (Sunshine binds an address, not a
#    device; see sunshine-tailscale). `iifname` matches interfaces that do not
#    exist yet, so it holds before Tailscale is up. The table and unit keep
#    their vnc_guard names from the wayvnc days, so existing machines and
#    their checks stay valid.
#    - The rules file is one atomic transaction (add/delete/redefine): a reload
#      never leaves a gap.
#    - agent-desktop-vnc-guard.service loads it at boot and keeps it: stopping
#      the unit never deletes the table (only the opt-out does, once nothing
#      listens on those ports).
#    - nftables.service, through a drop-in, loads /etc/nftables.conf and the
#      guard in ONE transaction, so even a `flush ruleset` in that file never
#      leaves the kernel without the guard, on restart or reload.
#    Not part of /etc/nftables.conf itself, whose SSH guard deliberately waits
#    for tailscale0.
sudo pacman -S --needed --noconfirm nftables
sudo install -d -m 0755 "$(dirname "$guard_rules")"
sudo tee "$guard_rules" >/dev/null <<EOF
#!/usr/bin/nft -f
$owner_header
# Managed by chezmoi (.chezmoiscripts/run_onchange_after_agent-desktop.sh.tmpl).
# Do not edit by hand. Sunshine: Tailscale-only. The add/delete/redefine
# prelude makes reloading idempotent and atomic.
add table inet vnc_guard
delete table inet vnc_guard
table inet vnc_guard {
  chain input {
    type filter hook input priority filter; policy accept;
    meta l4proto { tcp, udp } th dport $sunshine_ports iifname != { "lo", "tailscale0" } drop comment "sunshine: Tailscale-only"
  }
}
EOF
sudo tee "$guard_bundle" >/dev/null <<EOF
#!/usr/bin/nft -f
$owner_header
# Managed by chezmoi (.chezmoiscripts/run_onchange_after_agent-desktop.sh.tmpl).
# nftables.service loads this instead of /etc/nftables.conf on agent desktops:
# the system rules and the Sunshine guard in one transaction.
include "/etc/nftables.conf"
include "$guard_rules"
EOF
sudo nft -c -f "$guard_bundle"
sudo install -d -m 0755 "$(dirname "$guard_dropin")"
sudo tee "$guard_dropin" >/dev/null <<EOF
$owner_header
# Managed by chezmoi (.chezmoiscripts/run_onchange_after_agent-desktop.sh.tmpl).
# Agent desktop: load the system rules and the Sunshine guard atomically.
# Restart-only, like Arch's stock unit: it is a oneshot without
# RemainAfterExit, so it is inactive after running and \`reload\` never runs.
# Use \`systemctl restart nftables\`.
[Service]
ExecStart=
ExecStart=/usr/bin/nft -f $guard_bundle
EOF
sudo tee "$guard_unit" >/dev/null <<EOF
$owner_header
# Managed by chezmoi (.chezmoiscripts/run_onchange_after_agent-desktop.sh.tmpl).
[Unit]
Description=Agent desktop: drop Sunshine's ports off the Tailscale interface
Documentation=man:nft(8)
Wants=network-pre.target
Before=network-pre.target
After=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nft -f $guard_rules
ExecReload=/usr/bin/nft -f $guard_rules
# No ExecStop: stopping or restarting this unit never removes the guard.

[Install]
WantedBy=multi-user.target
EOF
sudo systemctl daemon-reload
sudo systemctl enable agent-desktop-vnc-guard.service
sudo systemctl reload-or-restart agent-desktop-vnc-guard.service
guard_table=$(sudo nft list table inet vnc_guard)
grep -q 'sunshine: Tailscale-only' <<<"$guard_table"
if grep -q 'wayvnc' <<<"$guard_table"; then
    echo "agent-desktop: the vnc_guard table still has a wayvnc rule after the reload" >&2
    exit 1
fi
echo "  ✓ firewall guard active (Sunshine's tcp and udp $sunshine_ports dropped off tailscale0)"

# 2. wayvnc is retired (Sunshine + Moonlight replaced it). Remove what an
#    earlier version of this setup wrote for it, with the opt-out's ownership
#    checks: the unit and wrapper (ownership line), the patched libneatvnc
#    (its marker), the restart marker, and the generated credentials (only in
#    the exact shape this setup wrote them). Nothing of it runs afterwards;
#    the wayvnc package stays installed, like every package this setup uses.
if user_manager && systemctl --user is-active --quiet wayvnc.service; then
    systemctl --user stop wayvnc.service
    echo "  ✓ stopped wayvnc (retired)"
fi
if [[ -L "$wants/wayvnc.service" && "$(readlink "$wants/wayvnc.service")" == "$user_units/wayvnc.service" ]]; then
    rm -f -- "$wants/wayvnc.service"
fi
remove_owned "$user_units/wayvnc.service" "$HOME/.local/bin/wayvnc-tailscale"
lib_state=$(classify "$neatvnc_lib/agent-desktop-managed") || fail "cannot inspect $neatvnc_lib"
if [[ "$lib_state" == owned ]]; then
    rm -rf -- "$neatvnc_lib"
    echo "  ✓ removed $neatvnc_lib (patched libneatvnc for wayvnc)"
fi
rm -f "$vnc_restart_marker"
if [[ -f "$vnc_config" && ! -L "$vnc_config" &&
    "$(cut -d= -f1 "$vnc_config" | paste -sd, -)" == enable_auth,relax_encryption,username,password ]]; then
    rm -f -- "$vnc_config"
    rmdir "$(dirname "$vnc_config")" 2>/dev/null || true
    echo "  ✓ removed the generated wayvnc credentials ($vnc_config)"
fi

# 3. Packages. wtype types text on Hyprland, grim backs computer-use-linux's
#    Hyprland window capture. agent-browser is pinned in the user's npm
#    prefix, never as root.
sudo pacman -S --needed --noconfirm wtype grim jq at-spi2-core
if ! command -v google-chrome-stable >/dev/null 2>&1; then
    yay -S --needed --noconfirm google-chrome
fi
agent_browser_version=0.27.0
agent_browser="$HOME/.npm-global/bin/agent-browser"
if [[ "$("$agent_browser" --version 2>/dev/null || true)" != "agent-browser $agent_browser_version" ]]; then
    npm install -g --prefix "$HOME/.npm-global" "agent-browser@$agent_browser_version"
fi
# Agents run non-interactive shells (T3, `zsh -lc`) that never read .zshrc, so
# ~/.npm-global/bin is off their PATH; ~/.local/bin is on it.
mkdir -p "$HOME/.local/bin"
if [[ -L "$HOME/.local/bin/agent-browser" || ! -e "$HOME/.local/bin/agent-browser" ]]; then
    ln -sfn "$agent_browser" "$HOME/.local/bin/agent-browser"
fi

# 4. /dev/uinput for the absolute pointer. `uaccess` grants the active seat
#    user an ACL (no `input` group, no re-login). Same rule KDE Connect ships;
#    kept here so it does not depend on that package.
printf '%s\nuinput\n' "$owner_header" | sudo tee "$uinput_module" >/dev/null
sudo modprobe uinput
sudo tee "$uinput_rule" >/dev/null <<EOF
$owner_header
# Managed by chezmoi (.chezmoiscripts/run_onchange_after_agent-desktop.sh.tmpl).
# computer-use-linux synthesizes pointer input through /dev/uinput; give the
# logged-in seat user access through a logind ACL.
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
EOF
sudo udevadm control --reload
sudo udevadm trigger --action=change --name-match=uinput

# 5. computer-use-linux release binaries, pinned and checked against both the
#    published .sha256 files and the hashes below. Bump all three together.
version=0.7.36
base="https://github.com/agent-sh/computer-use-linux/releases/download/v$version"
for binary in computer-use-linux computer-use-linux-cosmic computer-use-linux-indicator; do
    dest="$HOME/.local/bin/$binary"
    want="${bin_sha256[$binary]}"
    if [[ -x "$dest" ]] && [[ "$(sha256sum "$dest" | cut -d' ' -f1)" == "$want" ]]; then
        echo "  ✓ $binary $version already installed"
        continue
    fi
    asset="$binary-x86_64-unknown-linux-gnu"
    tmp=$(mktemp -d)
    curl -fsSL --retry 3 -o "$tmp/$asset" "$base/$asset"
    curl -fsSL --retry 3 -o "$tmp/$asset.sha256" "$base/$asset.sha256"
    (cd "$tmp" && sha256sum -c --quiet "$asset.sha256")
    echo "$want  $tmp/$asset" | sha256sum -c --quiet
    install -m 0755 "$tmp/$asset" "$dest"
    rm -rf "$tmp"
    echo "  ✓ $binary $version installed"
done

# 6. AT-SPI accessibility, so computer-use-linux can read element trees
#    (persists in dconf; the running AT-SPI bus follows the setting).
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface toolkit-accessibility true ||
        echo "  ⚠ could not enable toolkit-accessibility (no session bus?)"
fi

# 7. Sunshine, so Moonlight can stream this session (see sunshine-tailscale).
#    - Package: LizardByte's Arch build of a pinned release, checked against
#      the sha256 below (GitHub's published digest), installed only when
#      Sunshine is absent; a newer one installed later is left alone. Its
#      install script grants /usr/bin/sunshine cap_sys_admin (KMS capture) on
#      every install and upgrade; the pacman hook below re-applies it after
#      any rebuild that would not, and this step repairs it now.
#    - Web UI credentials: generated once into $sunshine_creds (0600, never in
#      the dotfiles), the source of truth, and written into Sunshine's own
#      store by sunshine-credentials whenever the store does not match.
#      Without them Sunshine would let the first visitor of the web UI set
#      them.
sunshine_pkg_version=2026.914.233613-1
sunshine_pkg_sha256=17eb8c4d823a2693038f40aeeab56943ef0d5d6ace8ac90b3693905b0acbba87
sunshine_pkg_url="https://github.com/LizardByte/Sunshine/releases/download/v${sunshine_pkg_version%-*}/sunshine-$sunshine_pkg_version-x86_64.pkg.tar.zst"
sunshine_installed=$(pacman -Q sunshine 2>/dev/null || true)
if [[ -z "$sunshine_installed" ]]; then
    tmp=$(mktemp -d)
    curl -fsSL --retry 3 -o "$tmp/sunshine.pkg.tar.zst" "$sunshine_pkg_url"
    echo "$sunshine_pkg_sha256  $tmp/sunshine.pkg.tar.zst" | sha256sum -c --quiet
    sudo pacman -U --needed --noconfirm "$tmp/sunshine.pkg.tar.zst"
    rm -rf "$tmp"
    touch "$sunshine_restart_marker"
    echo "  ✓ Sunshine $sunshine_pkg_version installed"
elif [[ "$sunshine_installed" != "sunshine $sunshine_pkg_version" ]]; then
    echo "  ⚠ $sunshine_installed is installed (pinned here: $sunshine_pkg_version); keeping it"
fi
missing_libs=$(ldd /usr/bin/sunshine | awk '/not found/ { print $1 }')
if [[ -n "$missing_libs" ]]; then
    echo "Sunshine cannot load: $missing_libs (rebuild or update the package)" >&2
    exit 1
fi
sudo install -d -m 0755 "$(dirname "$sunshine_hook")"
sudo tee "$sunshine_hook" >/dev/null <<EOF
$owner_header
# Managed by chezmoi (.chezmoiscripts/run_onchange_after_agent-desktop.sh.tmpl).
# Sunshine's KMS capture needs cap_sys_admin on its binary; keep it after
# every install or upgrade, whichever build provides /usr/bin/sunshine.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/bin/sunshine

[Action]
Description = Agent desktop: granting Sunshine cap_sys_admin for KMS capture...
When = PostTransaction
Exec = /usr/bin/setcap cap_sys_admin,cap_sys_nice+p /usr/bin/sunshine
EOF
if ! getcap /usr/bin/sunshine | grep -q 'cap_sys_admin'; then
    sudo setcap cap_sys_admin,cap_sys_nice+p /usr/bin/sunshine
    touch "$sunshine_restart_marker"
    echo "  ✓ granted Sunshine cap_sys_admin (KMS capture)"
fi
install -d -m 0700 "$sunshine_dir"
if [[ ! -e "$sunshine_creds" ]]; then
    password=$(python3 -c 'import secrets; print(secrets.token_urlsafe(24))')
    if [[ ! "$password" =~ ^[A-Za-z0-9_-]{32}$ ]]; then
        echo "Sunshine password generation failed" >&2
        exit 1
    fi
    new_creds=$(mktemp "$sunshine_creds.new.XXXXXX") # mktemp creates it 0600
    trap 'rm -f "$new_creds"' EXIT
    printf '# %s (machine.autologin); the opt-out keeps it (data).\n# Sunshine web UI login (https://<tailscale-host>:47990); used by sunshine-pair.\nusername=%s\npassword=%s\n' \
        "$owner_token" "$(id -un)" "$password" >"$new_creds"
    unset password
    mv -f "$new_creds" "$sunshine_creds"
    trap - EXIT
    echo "  ✓ generated Sunshine web UI credentials in $sunshine_creds"
fi
chmod 0600 "$sunshine_creds"
# Load the login into Sunshine's store whenever it does not match (computes
# the salted hash itself; no password in argv; pairings kept). The always-run
# run_after_agent-desktop-sunshine-credentials script repeats this check on
# every apply.
"$HOME/.local/bin/sunshine-credentials" sync

# 8. MCP registration. Codex keeps its servers in ~/.codex/config.toml; Claude
#    Code keeps user-scope servers in <config dir>/.claude.json, once for the
#    default home and once for the T3 home (CLAUDE_CONFIG_DIR).
if command -v codex >/dev/null 2>&1; then
    codex mcp remove computer-use-linux >/dev/null 2>&1 || true
    codex mcp add computer-use-linux -- "$launcher" >/dev/null
    echo "  ✓ Codex MCP: computer-use-linux"
fi
if command -v claude >/dev/null 2>&1; then
    for config_dir in "${claude_homes[@]}"; do
        claude_in "$config_dir" mcp remove --scope user computer-use-linux >/dev/null 2>&1 || true
        claude_in "$config_dir" mcp add --scope user computer-use-linux -- "$launcher" >/dev/null
        echo "  ✓ Claude MCP (${config_dir:-$HOME/.claude}): computer-use-linux"
    done
fi

# 9. Session services, enabled with plain symlinks (what `systemctl --user
#    enable` writes), so this works without a running user manager; they
#    start with graphical-session.target at every login.
mkdir -p "$wants"
for unit in agent-chrome.service sunshine.service; do
    ln -sfn "$user_units/$unit" "$wants/$unit"
done
if user_manager; then
    systemctl --user daemon-reload
    if systemctl --user is-active --quiet graphical-session.target; then
        # agent-chrome keeps running (agents may be mid-task in it).
        systemctl --user start agent-chrome.service
        # Sunshine: start it, or restart it when a run (this one or an earlier,
        # interrupted one) left the restart marker, or when it predates its
        # wrapper or unit. The marker goes only after the server is back up,
        # so an old server can never survive a lost restart.
        if systemctl --user is-active --quiet sunshine.service; then
            since=$(date -d "$(systemctl --user show -p ActiveEnterTimestamp --value sunshine.service)" +%s)
            newest=$({ stat -c %Y "$HOME/.local/bin/sunshine-tailscale" "$user_units/sunshine.service" \
                2>/dev/null || true; } | sort -n | tail -n1)
            if [[ -e "$sunshine_restart_marker" ]] || ((newest >= since)); then
                systemctl --user restart sunshine.service
                echo "  ✓ restarted Sunshine (its files changed since it started)"
            fi
        else
            systemctl --user start sunshine.service
        fi
        systemctl --user is-active --quiet sunshine.service
        rm -f "$sunshine_restart_marker"
        # A portal activated before the session (e.g. by an SSH agent) lacks the
        # Hyprland backend; the drop-in prevents that from now on, and this
        # heals an instance that is already stuck. Only touched when broken.
        if systemctl --user is-active --quiet xdg-desktop-portal.service; then
            interfaces=$(busctl --user introspect org.freedesktop.portal.Desktop \
                /org/freedesktop/portal/desktop 2>/dev/null || true)
            if ! grep -q '^org.freedesktop.portal.Screenshot ' <<<"$interfaces"; then
                systemctl --user restart xdg-desktop-portal.service
                echo "  ✓ restarted xdg-desktop-portal (it was missing the Hyprland backend)"
            fi
        fi
        restart_hypridle
    fi
else
    echo "  ⚠ no user systemd manager now; the services start at the next login"
fi

echo "✓ agent desktop ready. Check: computer-use-linux-session doctor | jq .readiness"
echo "  Sunshine: add the Tailscale IPv4 address in Moonlight, then run"
echo "    sunshine-pair PIN here (web UI https://<tailscale IPv4>:47990, login in $sunshine_creds)"
{{- else }}

echo "==> agent desktop opt-out: removing agent access"

# mcp_state CONFIG (toml|json) -> absent | owned | foreign; non-zero when the
# file cannot be read or parsed. Owned: the command is exactly our launcher.
mcp_state() {
    python3 -I - "$1" "$2" "$launcher" <<'PY'
import json
import sys
import tomllib

path, kind, launcher = sys.argv[1:]
try:
    with open(path, 'rb') as handle:
        data = tomllib.load(handle) if kind == 'toml' else json.load(handle)
except FileNotFoundError:
    print('absent')
    sys.exit(0)
except Exception as error:  # unreadable or unparsable: cannot tell
    print(f'cannot parse {path}: {error}', file=sys.stderr)
    sys.exit(1)
servers = data.get('mcp_servers' if kind == 'toml' else 'mcpServers') or {}
entry = servers.get('computer-use-linux')
if entry is None:
    print('absent')
elif isinstance(entry, dict) and entry.get('command') == launcher and not entry.get('args'):
    print('owned')
else:
    print('foreign')
PY
}

# Ownership gate, before changing anything: the same structured checks the
# cleanup uses (ownership line, pinned hashes, parsed MCP configs whose
# command is exactly our launcher). Nothing proven ours: change nothing.
proven=()
if [[ -s "$state_dir/enabled-at" ]]; then
    proven+=("the opt-in marker")
fi
for path in "$user_units/wayvnc.service" "$user_units/agent-chrome.service" \
    "$user_units/sunshine.service" "$HOME/.local/bin/sunshine-tailscale" \
    "$HOME/.local/bin/sunshine-pair" "$HOME/.local/bin/sunshine-credentials" "$sunshine_hook" \
    "$user_units/xdg-desktop-portal.service.d/agent-desktop.conf" "$launcher" \
    "$HOME/.local/bin/wayvnc-tailscale" "$neatvnc_lib/agent-desktop-managed" \
    "$HOME/.local/bin/computer-use-linux" "$HOME/.local/bin/computer-use-linux-cosmic" \
    "$HOME/.local/bin/computer-use-linux-indicator" "$guard_unit" "$guard_dropin" \
    "$guard_rules" "$guard_bundle" "$uinput_rule" "$uinput_module"; do
    state=$(classify "$path") || fail "cannot inspect $path"
    if [[ "$state" == owned ]]; then
        proven+=("$path")
    fi
done
for config in "$HOME/.codex/config.toml:toml" "$HOME/.claude.json:json" \
    "$HOME/.claude-t3-mixed/.claude.json:json"; do
    state=$(mcp_state "${config%:*}" "${config##*:}") || fail "cannot inspect ${config%:*}"
    if [[ "$state" == owned ]]; then
        proven+=("MCP entry in ${config%:*}")
    fi
done
if ((${#proven[@]} == 0)); then
    echo "  nothing here was provably written by the agent-desktop setup; nothing changed"
    exit 0
fi
echo "  proven ours: ${#proven[@]} item(s)"

# Prime sudo only now: a machine with nothing of ours never touches sudo.
sudo -v

# 0. Record the intent first: an install without a marker (interrupted, or
#    older than the marker) gets one now, and it is removed only at the very
#    end, so any failure below (non-zero exit) is retried by the next apply.
mkdir -p "$state_dir"
if [[ ! -s "$state_dir/enabled-at" ]]; then
    echo "unrecorded (opt-out began $(date -Is))" >"$state_dir/enabled-at"
fi

# check_not_running LABEL PGREP-ARGS...: with no user manager we cannot stop
# services, so succeed only if none of ours is running.
check_not_running() {
    local label=$1 rc=0
    shift
    pgrep -u "$uid" "$@" >/dev/null || rc=$?
    case $rc in
        0) fail "$label is running but the user systemd manager is absent; stop it first" ;;
        1) ;;
        *) fail "cannot check whether $label is running (pgrep failed)" ;;
    esac
}

# 1. Stop and remove our session services (only units this setup wrote).
if user_manager; then
    manager=running
else
    manager=absent
    check_not_running wayvnc -x wayvnc
    check_not_running "the wayvnc-tailscale wrapper" -f "$HOME/.local/bin/wayvnc-tailscale"
    check_not_running "the agent Chrome" -f "user-data-dir=$HOME/.local/share/agent-chrome"
    check_not_running Sunshine -x sunshine
    check_not_running "the sunshine-tailscale wrapper" -f "$HOME/.local/bin/sunshine-tailscale"
fi
for unit in wayvnc.service agent-chrome.service sunshine.service; do
    state=$(classify "$user_units/$unit") || fail "cannot inspect $user_units/$unit"
    if [[ "$state" != owned ]]; then
        [[ "$state" == foreign ]] && echo "  ⚠ left $unit alone: not written by this setup"
        continue
    fi
    if [[ "$manager" == running ]]; then
        active=$(systemctl --user show -p ActiveState --value "$unit") || fail "cannot query $unit"
        case $active in
            active | activating | reloading) systemctl --user stop "$unit" || fail "cannot stop $unit" ;;
        esac
    fi
    link="$wants/$unit"
    if [[ -L "$link" && "$(readlink "$link")" == "$user_units/$unit" ]]; then
        rm -f -- "$link"
    fi
    remove_owned "$user_units/$unit"
done
remove_owned "$user_units/xdg-desktop-portal.service.d/agent-desktop.conf"
rmdir "$user_units/xdg-desktop-portal.service.d" 2>/dev/null || true

# 2. The firewall guard goes only once nothing listens on 5900 or Sunshine's
#    ports; a failed `ss` is an error, not "nothing listening".
listeners=$(ss -ltunH "( sport = :5900 or ( sport >= :${sunshine_ports%-*} and sport <= :${sunshine_ports#*-} ) )") ||
    fail "cannot list listening sockets (ss failed)"
[[ -z "$listeners" ]] || fail "something still listens on tcp/5900 or Sunshine's ports; keeping the firewall guard"
guard_unit_state=$(classify "$guard_unit") || fail "cannot inspect $guard_unit"
guard_rules_state=$(classify "$guard_rules") || fail "cannot inspect $guard_rules"
remove_owned --sudo "$guard_dropin"
sudo rmdir "$(dirname "$guard_dropin")" 2>/dev/null || true
if [[ "$guard_unit_state" == owned ]]; then
    sudo systemctl disable agent-desktop-vnc-guard.service || fail "cannot disable the guard unit"
fi
remove_owned --sudo "$guard_unit"
sudo systemctl daemon-reload || fail "systemctl daemon-reload failed"
if [[ "$guard_unit_state" == owned || "$guard_rules_state" == owned ]]; then
    sudo systemctl reset-failed agent-desktop-vnc-guard.service 2>/dev/null || true
    tables=$(sudo nft list tables) || fail "cannot list nftables tables"
    if grep -qx 'table inet vnc_guard' <<<"$tables"; then
        sudo nft delete table inet vnc_guard || fail "cannot delete the vnc_guard table"
    fi
fi
remove_owned --sudo "$guard_rules" "$guard_bundle"
sudo rmdir "$(dirname "$guard_rules")" 2>/dev/null || true

# 3. MCP registrations: only entries whose command is our launcher. A config
#    that cannot be parsed, a missing CLI or a failed removal aborts.
mcp_remove() { # label config kind cli remove-command...
    local label=$1 config=$2 kind=$3 cli=$4 state
    shift 4
    state=$(mcp_state "$config" "$kind") || fail "cannot inspect $config"
    case $state in
        absent) return 0 ;;
        foreign)
            echo "  ⚠ left the computer-use-linux MCP entry in $config alone: not our launcher"
            return 0
            ;;
    esac
    command -v "$cli" >/dev/null 2>&1 || fail "$cli is not installed, cannot remove the MCP entry in $config"
    "$@" >/dev/null || fail "$label: removing the MCP entry failed"
    state=$(mcp_state "$config" "$kind") || fail "cannot inspect $config"
    [[ "$state" == absent ]] || fail "$label still lists computer-use-linux"
    echo "  ✓ removed the computer-use-linux MCP entry ($label)"
}
mcp_remove Codex "$HOME/.codex/config.toml" toml codex \
    codex mcp remove computer-use-linux
mcp_remove "Claude ($HOME/.claude)" "$HOME/.claude.json" json claude \
    env -u CLAUDE_CONFIG_DIR claude mcp remove --scope user computer-use-linux
mcp_remove "Claude ($HOME/.claude-t3-mixed)" "$HOME/.claude-t3-mixed/.claude.json" json claude \
    env CLAUDE_CONFIG_DIR="$HOME/.claude-t3-mixed" claude mcp remove --scope user computer-use-linux

# 4. Session helpers, binaries, the patched library and the agent-browser link.
remove_owned "$launcher" "$HOME/.local/bin/wayvnc-tailscale" \
    "$HOME/.local/bin/sunshine-tailscale" "$HOME/.local/bin/sunshine-pair" \
    "$HOME/.local/bin/sunshine-credentials" \
    "$HOME/.local/bin/computer-use-linux" "$HOME/.local/bin/computer-use-linux-cosmic" \
    "$HOME/.local/bin/computer-use-linux-indicator"
lib_state=$(classify "$neatvnc_lib/agent-desktop-managed") || fail "cannot inspect $neatvnc_lib"
if [[ "$lib_state" == owned ]]; then
    rm -rf -- "$neatvnc_lib" || fail "cannot remove $neatvnc_lib"
    echo "  ✓ removed $neatvnc_lib"
elif [[ -e "$neatvnc_lib" ]]; then
    echo "  ⚠ left $neatvnc_lib alone: not written by this setup"
fi
if [[ -L "$HOME/.local/bin/agent-browser" &&
    "$(readlink "$HOME/.local/bin/agent-browser")" == "$HOME/.npm-global/bin/agent-browser" ]]; then
    rm -f -- "$HOME/.local/bin/agent-browser"
fi

# 5. uinput access rule and the Sunshine capability hook (the package and its
#    own capability stay, like the other packages).
remove_owned --sudo "$uinput_rule" "$uinput_module" "$sunshine_hook"
sudo rmdir "$(dirname "$sunshine_hook")" 2>/dev/null || true
sudo udevadm control --reload || fail "udevadm reload failed"
sudo udevadm trigger --action=change --name-match=uinput || fail "udevadm trigger failed"

# 6. Restored idle/lock policy for the running session. Without a user
#    manager there is no session, so no hypridle may be running either.
if [[ "$manager" == running ]]; then
    systemctl --user daemon-reload || fail "systemctl --user daemon-reload failed"
    restart_hypridle
else
    check_not_running hypridle -x hypridle
fi

# Done: only now drop the opt-in marker.
date -Is >"$state_dir/disabled-at"
rm -f "$vnc_restart_marker" "$sunshine_restart_marker" "$state_dir/sunshine-credentials.lock" \
    "$state_dir/sunshine-credentials-restart-pending" "$state_dir/enabled-at"
echo "✓ agent access removed. Kept: ~/.local/share/agent-chrome (Chrome profile),"
echo "  $vnc_config (wayvnc credentials), $sunshine_dir (Sunshine pairings and"
echo "  web UI credentials), installed packages, and the toolkit-accessibility setting."
{{- end }}
{{ end -}}
