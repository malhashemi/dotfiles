{{- /*
  Agent desktop (machine.autologin): on every apply, make sure Sunshine's
  credential store still holds the login from web-ui-credentials, the source
  of truth, and repair it if not (sunshine-credentials sync). No side effects
  when it matches. The one-time setup is run_onchange_after_agent-desktop;
  until it has generated the login this does nothing. Every other machine:
  renders empty, so nothing runs.
*/ -}}
{{- if and (eq .chezmoi.os "linux") (get (get . "machine" | default dict) "autologin") -}}
#!/usr/bin/env bash
# Agent desktop: keep Sunshine's web UI login in step with
# ~/.config/sunshine/web-ui-credentials (runs on every chezmoi apply).
set -euo pipefail

helper="$HOME/.local/bin/sunshine-credentials"
creds="$HOME/.config/sunshine/web-ui-credentials"
[[ -x "$helper" && -e "$creds" ]] || exit 0

# Tailscale SSH sessions skip pam_systemd; point user-bus tools at the session.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
"$helper" sync
{{ end -}}
